# AuthCore environment variables
# Copy this file to .env and fill in real values

# Database connection string
# For local development with docker-compose:
DATABASE_URL="postgresql://authcore:authcore_secret@localhost:5433/authcore_test"

# Secret key for signing JWTs (min 32 chars in production)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Optional: Resend API key for email features
# RESEND_API_KEY=""

# Optional: SMTP settings for nodemailer adapter
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
