# AuthCore example — copy to .env.local before running
# (.env.local is gitignored by Next.js by default)

# Required. >= 32 chars. Generate with: openssl rand -base64 48
AUTH_SECRET=please-generate-a-strong-secret-of-at-least-32-chars

# Required. Where this app is reachable. Used to build links in emails.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Optional: Google OAuth ---
# Register an OAuth Client ID at https://console.cloud.google.com/apis/credentials.
# Authorized redirect URI: ${NEXT_PUBLIC_BASE_URL}/api/auth/oauth/google/callback
# Leave blank to disable the "Sign in with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: Resend (real email delivery) ---
# When unset, magic-link emails are printed to the server console so you can
# copy-paste the link for local testing.
RESEND_API_KEY=
RESEND_FROM=auth@yourdomain.com
