{
  "name": "@authcore/react",
  "version": "0.6.0",
  "description": "React SDK for AuthCore — AuthProvider, useAuth, ProtectedRoute",
  "author": "David Ouatedem",
  "repository": {
    "type": "git",
    "url": "https://github.com/david-ouatedem/auth-core",
    "directory": "packages/react"
  },
  "keywords": ["auth", "authcore", "react", "hooks"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@authcore/core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.0.0",
    "jsdom": "^24.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT"
}
