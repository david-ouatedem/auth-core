{
  "name": "@authcore/resend-adapter",
  "version": "0.5.4",
  "description": "Resend email adapter for AuthCore",
  "author": "David Ouatedem",
  "repository": {
    "type": "git",
    "url": "https://github.com/david-ouatedem/auth-core",
    "directory": "packages/resend-adapter"
  },
  "keywords": ["auth", "authcore", "resend", "email"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@authcore/core": "workspace:^"
  },
  "peerDependencies": {
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "resend": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT"
}
