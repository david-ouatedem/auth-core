{
  "name": "@authcore/express",
  "version": "0.12.0",
  "description": "Express authentication in one call: mount a router with register, login, refresh, email verification, password reset, OAuth and 2FA, plus middleware and RBAC (AuthCore)",
  "license": "MIT",
  "author": "David Ouatedem",
  "repository": {
    "type": "git",
    "url": "https://github.com/david-ouatedem/auth-core",
    "directory": "packages/express"
  },
  "keywords": [
    "auth",
    "authcore",
    "express",
    "middleware",
    "authentication",
    "jwt",
    "typescript",
    "router",
    "rbac",
    "cookie",
    "bearer"
  ],
  "files": [
    "dist",
    "README.md",
    "AGENTS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@authcore/core": "workspace:^",
    "@authcore/types": "workspace:^"
  },
  "peerDependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@authcore/prisma-adapter": "workspace:^",
    "@prisma/client": "^5.22.0",
    "@types/express": "^4.17.21",
    "express": "^4.21.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "homepage": "https://david-ouatedem.github.io/auth-core/",
  "bugs": {
    "url": "https://github.com/david-ouatedem/auth-core/issues"
  }
}
