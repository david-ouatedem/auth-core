{
  "name": "@authcore/prisma-adapter",
  "version": "0.8.0",
  "description": "Prisma database adapter for AuthCore",
  "license": "MIT",
  "author": "David Ouatedem",
  "repository": {
    "type": "git",
    "url": "https://github.com/david-ouatedem/auth-core",
    "directory": "packages/prisma-adapter"
  },
  "keywords": [
    "auth",
    "authcore",
    "prisma",
    "database",
    "adapter"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push --schema ./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ./prisma/schema.prisma",
    "db:generate": "prisma generate --schema ./prisma/schema.prisma"
  },
  "dependencies": {
    "@authcore/types": "workspace:^"
  },
  "peerDependencies": {
    "@prisma/client": "^5.0.0 || ^6.0.0",
    "prisma": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "prisma": { "optional": true }
  },
  "devDependencies": {
    "@authcore/core": "^0.6.0",
    "@prisma/client": "^5.22.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.0",
    "prisma": "^5.22.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
