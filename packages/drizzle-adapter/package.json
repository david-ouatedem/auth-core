{
  "name": "@authcore/drizzle-adapter",
  "version": "0.11.0",
  "description": "Drizzle ORM database adapter for AuthCore (Postgres + SQLite)",
  "license": "MIT",
  "author": "David Ouatedem",
  "repository": {
    "type": "git",
    "url": "https://github.com/david-ouatedem/auth-core",
    "directory": "packages/drizzle-adapter"
  },
  "keywords": [
    "auth",
    "authcore",
    "drizzle",
    "drizzle-orm",
    "postgres",
    "sqlite"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./pg": {
      "import": "./dist/pg/index.js",
      "types": "./dist/pg/index.d.ts"
    },
    "./sqlite": {
      "import": "./dist/sqlite/index.js",
      "types": "./dist/sqlite/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@authcore/core": "workspace:^",
    "@authcore/types": "workspace:^"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.30.0 <0.40.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.27.0",
    "drizzle-orm": "^0.36.0",
    "pg": "^8.12.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
