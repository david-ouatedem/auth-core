{
  "name": "@authcore/core-web",
  "version": "0.12.0",
  "description": "Framework-agnostic browser auth client for AuthCore (fetch-based, api/cookie modes, session persistence)",
  "license": "MIT",
  "author": "Phanuel Wayne",
  "repository": {
    "type": "git",
    "url": "https://github.com/david-ouatedem/auth-core",
    "directory": "packages/core-web"
  },
  "keywords": [
    "auth",
    "authentication",
    "authcore",
    "jwt",
    "typescript",
    "browser",
    "fetch",
    "session",
    "client",
    "cookie"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@authcore/types": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "homepage": "https://david-ouatedem.github.io/auth-core/",
  "bugs": {
    "url": "https://github.com/david-ouatedem/auth-core/issues"
  }
}
